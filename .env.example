# Copy to .env and adjust as needed:  cp .env.example .env

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlasdb

# --- Ollama -----------------------------------------------------------------
# Model pulled by the `ollama` service on startup. The model actually used for
# embeddings is configured in the app (stored in the `settings` table).
OLLAMA_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=24h

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Deployment -------------------------------------------------------------
# Use a published image instead of building locally. When set, start the stack
# with `docker compose up -d --no-build`.
# ATLAS_IMAGE=ghcr.io/oar06g/atlas-index:latest

# --- Indexing queue ---------------------------------------------------------
# Chunks sent per embedding request (lower is safer on slow machines).
EMBED_BATCH_SIZE=4
# Per-request timeout in milliseconds; failed batches are retried and split.
EMBED_TIMEOUT_MS=120000
